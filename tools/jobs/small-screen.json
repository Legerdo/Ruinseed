[
  { "name": "small-boss", "q": "scene=play&seed=1&speed=2", "w": 640, "h": 360, "waitFor": "window.RST && window.RST.ready()", "wait": 300,
    "actions": [
      { "type": "eval", "code": "(()=>{const g=RST.g(); g.godMode=true; RS.Cheats.toBoss(g); return 'ok';})()" },
      { "type": "wait", "ms": 800 },
      { "type": "key", "key": "KeyW", "ms": 1500 },
      { "type": "wait", "ms": 2500 },
      { "type": "shot", "name": "small_boss.png" },
      { "type": "eval", "code": "(()=>{ window.BOT=setInterval(()=>{const g=RST.g(); if(!g||!g.boss||g.boss.dead) return; const b=g.boss; if(!b.hittable) return; const p=g.player; if(p.state==='attack') return; p.x=b.x+(Math.random()<0.5?-6:6); p.y=b.y+20; p.dir='up'; p.buffer.attack=0.14;}, 60); return 'bot'; })()" },
      { "type": "waitFor", "code": "(()=>{const g=RST.g(); return !g || !g.boss || g.boss.hp < 50;})()", "timeout": 60000 },
      { "type": "shot", "name": "small_boss2.png" },
      { "type": "waitFor", "code": "RS.App.sceneName==='victory'", "timeout": 90000 },
      { "type": "wait", "ms": 1500 },
      { "type": "shot", "name": "small_victory.png" }
    ]
  },
  { "name": "small-defeat", "q": "scene=play&seed=2", "w": 640, "h": 360, "waitFor": "window.RST && window.RST.ready()", "wait": 300,
    "actions": [
      { "type": "eval", "code": "(()=>{const g=RST.g(); g.player.inv=0; g.player.hp=1; g.damagePlayer(2, g.player.x+10, g.player.y); return 'dmg';})()" },
      { "type": "waitFor", "code": "RS.App.sceneName==='defeat'", "timeout": 10000 },
      { "type": "wait", "ms": 1200 },
      { "type": "shot", "name": "small_defeat.png" }
    ]
  },
  { "name": "small-dungeon", "q": "scene=play&seed=3", "w": 640, "h": 360, "waitFor": "window.RST && window.RST.ready()", "wait": 300,
    "actions": [
      { "type": "eval", "code": "(()=>{const g=RST.g(); g.run.talked=true; const i=g.world.dungeons.findIndex(d=>d.theme==='ember'); g.enterDungeon(i); return 'd'+i;})()" },
      { "type": "wait", "ms": 1800 },
      { "type": "shot", "name": "small_dungeon.png" },
      { "type": "eval", "code": "(()=>{const g=RST.g(); g.toast('회복약을 얻었다', RS.PAL.gold5); g.toast('잉걸의 인장을 얻었다!', RS.PAL.gold5, '인장 1/3'); return 't';})()" },
      { "type": "wait", "ms": 400 },
      { "type": "shot", "name": "small_toast.png" }
    ]
  },
  { "name": "small-loading", "q": "scene=title", "w": 640, "h": 360, "wait": 300,
    "actions": [
      { "type": "press", "key": "Enter" }, { "type": "wait", "ms": 200 },
      { "type": "eval", "code": "(()=>{RS.App.setScene('loading',{seed:9090, attempt:1}); return 'l';})()" },
      { "type": "wait", "ms": 120 },
      { "type": "shot", "name": "small_loading.png" }
    ]
  }
]
