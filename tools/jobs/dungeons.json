      { "type": "eval", "code": "(()=>{const g=RST.g(); const d=g.dungeonData[0]; RS.DungeonRuntime.openSeal(g,d); RST.tp(d.pedestal.tx, d.pedestal.ty+2); g.player.dir='up'; return 'ped';})()" },
      { "type": "wait", "ms": 600 },
      { "type": "shot", "name": "d0_pedestal.png" },
      { "type": "eval", "code": "(()=>{const g=RST.g(); const d=g.dungeonData[0]; g.interact(d.pedestalObj); return JSON.stringify(g.run.sigils);})()" },
      { "type": "wait", "ms": 700 },
      { "type": "shot", "name": "d0_sigil.png" },
      { "type": "eval", "code": "(()=>{const g=RST.g(); g.exitDungeon(); return 'exit';})()" },
      { "type": "wait", "ms": 1400 },
      { "type": "shot", "name": "d0_exit.png" },
      { "type": "eval", "code": "JSON.stringify(RST.info())" },
      { "type": "eval", "code": "RST.g().enterDungeon(1); 'enter1'" },
      { "type": "wait", "ms": 1500 },
      { "type": "shot", "name": "d1_entry.png" },
      { "type": "eval", "code": "(()=>{const g=RST.g(); const d=g.dungeonData[1]; const rm=d.rooms[Math.floor(d.rooms.length/2)]; RST.tp(rm.cx, rm.cy); return d.theme;})()" },
      { "type": "wait", "ms": 500 },
      { "type": "shot", "name": "d1_room.png" },
      { "type": "eval", "code": "(()=>{const g=RST.g(); g.exitDungeon(); return 'x';})()" },
      { "type": "wait", "ms": 1400 },
