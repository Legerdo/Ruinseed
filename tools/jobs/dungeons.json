      { "type": "eval", "code": "(()=>{const g=RST.g(); const d=g.dungeonData[2]; const rm=d.rooms[Math.floor(d.rooms.length/2)]; RST.tp(rm.cx, rm.cy); return d.theme;})()" },
      { "type": "wait", "ms": 500 },
      { "type": "shot", "name": "d2_room.png" },
      { "type": "eval", "code": "(()=>{RS.Cheats.toBoss(RST.g()); return 'boss';})()" },
      { "type": "wait", "ms": 1500 },
      { "type": "shot", "name": "arena_entry.png" },
      { "type": "key", "key": "KeyW", "ms": 1600 },
